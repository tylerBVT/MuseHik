{
  "name": "musehik",
  "productName": "MuseHik",
  "version": "1.0.4",
  "description": "MuseHik, the music app",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "author": "tylerBVT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "stage": "node scripts/stage.mjs",
    "dist": "node scripts/stage.mjs && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "smoke": "node scripts/smoke.mjs dist/win-unpacked/resources"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.tylerbvt.musehik",
    "productName": "MuseHik",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "loading.html",
      "layout.mjs",
      "python.mjs",
      "updates.mjs",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "stage",
        "to": ".",
        "filter": [
          "node/**/*",
          "backend/**/*",
          "web/**/*",
          "python/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MuseHik",
      "artifactName": "MuseHik-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "tylerBVT",
        "repo": "MuseHik",
        "releaseType": "release"
      }
    ]
  }
}
