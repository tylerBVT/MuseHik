# Third-party repos kept only as reading inspiration (they have their own git history)
/openSourceProjects/

# Downloaded audio (large, personal). Keep the folder itself.
/downloadedMusic/*
!/downloadedMusic/.gitkeep

# Dependencies and build output
node_modules/
.venv/
dist/
.angular/
__pycache__/

# Local runtime files
*.log
.idea/

# Machine-specific settings (copy backend/config.example.json to backend/config.json)
backend/config.json

# Local library index
backend/data/

# Plan execution scratch (superpowers)
.superpowers/

# Desktop app build output
desktop/stage/
desktop/dist/
desktop/server.log
